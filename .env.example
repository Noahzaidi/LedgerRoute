# LedgerRoute configuration. Copy to .env for local use; keep credentials out of Git.

# Which LLM client the agent uses: "fake" (deterministic, no API key) or "anthropic" (Claude).
LLM_PROVIDER=fake

# Only used with LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low, medium, high, xhigh or max.
ANTHROPIC_EFFORT=medium

# Reference catalogs and reviewed historical resolutions. The bundled synthetic data is
# intended for local integration; set DATA_DIR to your organization's configuration directory.
# DATA_DIR=data

# SQLite files. A relative override is relative to the process working directory.
# OPERATIONAL_DB_PATH=var/operational.db
# ANALYTICS_DB_PATH=var/analytics.db

LOG_LEVEL=INFO
